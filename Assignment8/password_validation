def main():
    # Ask the user to enter a password
    password = input("Enter a password: ")
    
    # Initialize flags for our validation checks
    is_valid = True
    has_upper = False
    has_lower = False
    has_digit = False
    has_invalid_char = False
    
    # 1. Check length
    if len(password) < 8:
        print("Password must be at least 8 characters long.")
        is_valid = False
        
    # Iterate through each character to check for requirements
    for char in password:
        if char.isupper():
            has_upper = True
        elif char.islower():
            has_lower = True
        elif char.isdigit():
            has_digit = True
        else:
            # If it's not upper, lower, or a digit, it's an invalid character
            has_invalid_char = True

    # 2. Check for character types (uppercase, lowercase, digit)
    if not (has_upper and has_lower and has_digit):
        print("Password must contain at least one uppercase letter, one lowercase letter, and one digit.")
        is_valid = False

    # 3. Check for invalid characters (symbols, spaces, etc.)
    if has_invalid_char:
        print("Password may only contain letters and digits.")
        is_valid = False

    # Final output based on validation results
    if is_valid:
        print("Password is valid.")
    else:
        print("Password is invalid.")

# Run the program
if __name__ == "__main__":
    main()