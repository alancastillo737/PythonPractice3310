def main():
    # asking for the date
    date_str = input("Enter a date in the format mm/dd/yyyy: ")
    
    # First check if there are slashes
    if "/" not in date_str:
        print("Error: Date must be in mm/dd/yyyy format with slashes.")
    else:
        # split the string up
        parts = date_str.split("/")
        
        # check if there are 3 parts
        if len(parts) != 3:
            print("Error: Date must be in mm/dd/yyyy format with slashes.")
        else:
            # grab the parts
            mm = parts[0]
            dd = parts[1]
            yyyy = parts[2]
            
            # try to turn them into numbers
            # (this might crash if they typed letters, but the assignment didn't ask for that)
            month_num = int(mm)
            day_num = int(dd)
            
            # Check the month
            if month_num < 1 or month_num > 12:
                print("Error: Month must be between 1 and 12.")
            else:
                # Check the day
                if day_num < 1 or day_num > 31:
                    print("Error: Day must be between 1 and 31.")
                else:
                    # Now we need to get the month name
                    month_name = ""
                    
                    if month_num == 1:
                        month_name = "January"
                    elif month_num == 2:
                        month_name = "February"
                    elif month_num == 3:
                        month_name = "March"
                    elif month_num == 4:
                        month_name = "April"
                    elif month_num == 5:
                        month_name = "May"
                    elif month_num == 6:
                        month_name = "June"
                    elif month_num == 7:
                        month_name = "July"
                    elif month_num == 8:
                        month_name = "August"
                    elif month_num == 9:
                        month_name = "September"
                    elif month_num == 10:
                        month_name = "October"
                    elif month_num == 11:
                        month_name = "November"
                    elif month_num == 12:
                        month_name = "December"
                    
                    # print the final result
                    # Note: The example output didn't have leading zeros for the day, 
                    # so we use day_num instead of dd
                    print(month_name + " " + str(day_num) + ", " + yyyy)

main()